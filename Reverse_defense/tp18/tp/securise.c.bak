    buf[strcspn(buf, "\r\n")] = '\0';

    printf("Code recu : %s\n", buf);

    /* TODO(2) : effacer le secret de la memoire avant de quitter la fonction. */
    /* memset(secret, 0, sizeof(secret)); */     /* <<< A ACTIVER   */
    (void)secret;
}

